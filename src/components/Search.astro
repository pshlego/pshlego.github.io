---
import Icon from "@/components/Icon.astro";
---

<!-- Search is powered by Pagefind, whose index is generated by `npm run build`. -->
<button id="open-search" class="icon-btn" type="button" aria-label="Search">
	<Icon name="search" class="h-7 w-7" />
</button>
<dialog
	id="search-dialog"
	aria-label="Search"
	class="bg-bgColor text-textColor mx-auto mt-16 max-h-[80vh] w-[min(40rem,calc(100%-2rem))] rounded-md p-4 shadow-xl backdrop:backdrop-blur-sm"
>
	<div class="mb-2 flex justify-end">
		<button id="close-search" type="button" class="cursor-pointer" aria-label="Close search">
			<Icon name="close" class="h-5 w-5" />
		</button>
	</div>
	<div id="pagefind-search"></div>
	<p id="search-unavailable" class="hidden text-sm opacity-70">
		Search is available on the built site (run <code>npm run build</code>).
	</p>
</dialog>

<script>
	const dialog = document.getElementById("search-dialog") as HTMLDialogElement;
	let loaded = false;

	async function loadPagefind() {
		if (loaded) return;
		loaded = true;
		try {
			const link = document.createElement("link");
			link.rel = "stylesheet";
			link.href = "/pagefind/pagefind-ui.css";
			document.head.append(link);
			await new Promise<void>((resolve, reject) => {
				const script = document.createElement("script");
				script.src = "/pagefind/pagefind-ui.js";
				script.onload = () => resolve();
				script.onerror = () => reject(new Error("pagefind not built"));
				document.head.append(script);
			});
			// @ts-expect-error PagefindUI is a global from the script above.
			new PagefindUI({ element: "#pagefind-search", showImages: false, resetStyles: false });
			dialog.querySelector<HTMLInputElement>("input")?.focus();
		} catch {
			document.getElementById("search-unavailable")!.classList.remove("hidden");
		}
	}

	document.getElementById("open-search")!.addEventListener("click", () => {
		dialog.showModal();
		loadPagefind();
		dialog.querySelector<HTMLInputElement>("input")?.focus();
	});
	document.getElementById("close-search")!.addEventListener("click", () => dialog.close());
	dialog.addEventListener("click", (e) => {
		if (e.target === dialog) dialog.close();
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "/" && !dialog.open && !(e.target instanceof HTMLInputElement)) {
			e.preventDefault();
			document.getElementById("open-search")!.click();
		}
	});
</script>

<style is:global>
	#pagefind-search {
		--pagefind-ui-primary: var(--color-accent);
		--pagefind-ui-text: var(--color-textColor);
		--pagefind-ui-background: var(--color-bgColor);
		--pagefind-ui-border: color-mix(in srgb, var(--color-textColor) 25%, transparent);
		--pagefind-ui-tag: color-mix(in srgb, var(--color-textColor) 10%, transparent);
		--pagefind-ui-font: inherit;
	}
</style>
