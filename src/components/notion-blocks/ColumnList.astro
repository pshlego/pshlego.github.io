---
import * as interfaces from "@/lib/interfaces.ts";
import NotionBlocks from "@/components/NotionBlocks.astro";

export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;
---

<div class="notion-column-list">
	{
		block.ColumnList.Columns.map((column: interfaces.Column) => {
			// 이미지만 있는 컬럼인지 확인
			const isImageOnlyColumn = column.Children.length > 0 &&
				column.Children.every((child) => child.Type === "image");
			// 이미지 컬럼: 콘텐츠 크기 유지, 텍스트 컬럼: 남은 공간 확장
			const flexStyle = isImageOnlyColumn ? "flex: 0 0 auto;" : "flex: 1 1 0%;";
			return (
				<div class="ncolumns min-w-0" style={flexStyle}>
					<NotionBlocks blocks={column.Children} renderChildren={renderChildren} setId={setId} />
				</div>
			);
		})
	}
</div>
