---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import PostLayout from "@/layouts/PostLayout.astro";
import Authors from "@/components/Authors.astro";
import { getNotes, getPublications, type Note, type Publication } from "@/lib/content";

export const getStaticPaths = (async () => {
	const pubs = await getPublications();
	const notes = await getNotes();
	const seen = new Set<string>();
	for (const { id } of [...pubs, ...notes]) {
		if (seen.has(id)) throw new Error(`Duplicate /posts/${id}/ in publications and notes`);
		seen.add(id);
	}
	return [
		...pubs.map((entry) => ({ params: { slug: entry.id }, props: { pub: entry } })),
		...notes.map((entry) => ({ params: { slug: entry.id }, props: { note: entry } })),
	];
}) satisfies GetStaticPaths;

interface Props {
	pub?: Publication;
	note?: Note;
}

const { pub, note } = Astro.props;
const entry = (pub ?? note)!;
const { Content } = await render(entry);
const ogImage = pub?.data.image
	? (await getImage({ src: pub.data.image, width: 1200 })).src
	: undefined;
const buttons = pub
	? [
			{ key: "pdf", label: "PDF", href: pub.data.links.pdf },
			{ key: "project", label: "Project", href: pub.data.links.project },
			{ key: "code", label: "Code", href: pub.data.links.code },
		].filter((b) => b.href)
	: [];
---

<PostLayout
	title={entry.data.title}
	date={entry.data.date}
	tags={entry.data.tags}
	description={pub ? `${pub.data.authors.join(", ")}. ${pub.data.venue}.` : note?.data.description}
	image={ogImage}
>
	{
		pub && (
			<Fragment slot="byline">
				<p class="text-sm">
					<Authors authors={pub.data.authors} />
				</p>
				<p class="mt-1 text-sm italic opacity-70">
					{pub.data.venue}
					{pub.data.award && ` | 🏆 ${pub.data.award}`}
				</p>
			</Fragment>
		)
	}
	{
		pub && (
			<>
				{buttons.length > 0 && (
					<div class="mb-6 flex flex-wrap gap-2">
						{buttons.map((b) => (
							<a
								href={b.href}
								target="_blank"
								rel="noopener noreferrer"
								class={`publication-btn publication-btn-${b.key}`}
							>
								{b.label}
							</a>
						))}
					</div>
				)}
				{pub.data.image && (
					<Image
						src={pub.data.image}
						alt={`Overview figure of ${pub.data.title}`}
						widths={[700, 1400]}
						sizes="(max-width: 768px) 100vw, 700px"
						loading="eager"
						class="mb-6 w-full rounded-md"
					/>
				)}
			</>
		)
	}
	<div class="prose">
		<Content />
	</div>
</PostLayout>
