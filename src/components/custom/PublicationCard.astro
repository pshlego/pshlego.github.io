---
import { Image } from "astro:assets";
import type { Post } from "@/lib/interfaces";
import {
    resolvePostHref,
    isExternalPost,
    getNotionImage,
    filePath,
    getImageComponentFormat,
} from "@/lib/blog-helpers";
import { getIconTailwindFilterStyle } from "@/utils/style-helpers";
import { isNotionHostedIconUrl } from "@/lib/notion/client";

interface Props {
    post: Post;
}

const { post } = Astro.props;

// Excerpt에서 저자, 학회, 링크 정보 파싱
function parseExcerpt(excerpt: string) {
    const lines = excerpt.split('\n');
    const authors = lines[0] || '';
    const venue = lines[1] || '';
    const links: Record<string, string> = {};

    // '---' 이후의 라인에서 링크 파싱
    const separatorIndex = lines.findIndex(line => line.trim() === '---');
    if (separatorIndex !== -1) {
        lines.slice(separatorIndex + 1).forEach(line => {
            const match = line.match(/^(pdf|project|code):\s*(.+)$/i);
            if (match && match[1] && match[2]) {
                links[match[1].toLowerCase()] = match[2].trim();
            }
        });
    }

    return { authors, venue, links };
}

const { authors, venue, links } = parseExcerpt(post.Excerpt || '');

// Link handling
const postLink = resolvePostHref(post);
const external = isExternalPost(post);

// Icon handling (MentionPage.astro 패턴 참조)
let downloadedIcon = null;
let externalIconPath: string | null = null;

if (post?.Icon && "Url" in post.Icon && post.Icon.Url) {
    const iconUrl = post.Icon.Url;
    const isNotionIcon = isNotionHostedIconUrl(iconUrl);
    const canBeCachedLocally =
        post.Icon.Type === "file" || post.Icon.Type === "custom_emoji" || isNotionIcon;

    if (canBeCachedLocally) {
        downloadedIcon = await getNotionImage(new URL(iconUrl));
    }
    if (!downloadedIcon) {
        externalIconPath = iconUrl;
    }
}

// FeaturedImage handling (PostCardGallery.astro 패턴 참조)
const hasFeaturedImage = post.FeaturedImage && post.FeaturedImage.Url;
let featuredImageMetadata: ImageMetadata | null = null;
let featuredImageUrl = "";

if (hasFeaturedImage && post.FeaturedImage) {
    try {
        const imgUrl = new URL(post.FeaturedImage.Url);
        featuredImageMetadata = await getNotionImage(imgUrl);
        if (!featuredImageMetadata) {
            featuredImageUrl = filePath(imgUrl);
        }
    } catch {
        featuredImageUrl = post.FeaturedImage.Url;
    }
}
---

<article class="publication-card">
    <div class="flex flex-col md:flex-row gap-4">
        <div class="md:w-1/3 flex-shrink-0">
            {featuredImageMetadata ? (
                <Image
                    src={featuredImageMetadata}
                    alt={post.Title}
                    class="w-full h-32 md:h-40 object-cover rounded-lg"
                    widths={[300, 400]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                />
            ) : featuredImageUrl ? (
                <img src={featuredImageUrl} alt={post.Title}
                     class="w-full h-32 md:h-40 object-cover rounded-lg" />
            ) : (
                <div class="w-full h-32 md:h-40 bg-accent/10 rounded-lg
                            flex items-center justify-center text-sm text-textColor/50">
                    No Image
                </div>
            )}
        </div>
        <div class="flex-1 md:w-2/3">
            <h3 class="text-lg font-semibold mb-2 leading-tight">
                {/* Icon rendering */}
                {post.Icon && "Emoji" in post.Icon && post.Icon.Type === "emoji" && (
                    <span class="mr-1">{post.Icon.Emoji}</span>
                )}
                {post.Icon && "Url" in post.Icon && (post.Icon.Type === "external" || post.Icon.Type === "file" || post.Icon.Type === "custom_emoji") && (
                    downloadedIcon ? (
                        <Image
                            src={downloadedIcon}
                            class={`inline h-5 w-5 mr-1 align-text-bottom ${getIconTailwindFilterStyle(post.Icon.Url)}`}
                            widths={[100]}
                            sizes="40px"
                            alt=""
                            format={getImageComponentFormat(downloadedIcon)}
                        />
                    ) : externalIconPath ? (
                        <img
                            src={externalIconPath}
                            class={`inline h-5 w-5 mr-1 align-text-bottom ${getIconTailwindFilterStyle(post.Icon.Url)}`}
                            alt=""
                        />
                    ) : null
                )}
                <a href={postLink}
                   class="text-textColor hover:text-link transition-colors"
                   target={external ? "_blank" : undefined}
                   rel={external ? "nofollow noopener" : undefined}>
                    {post.Title}
                </a>
            </h3>
            <p class="text-sm text-textColor/70 mb-2">{authors}</p>
            <p class="text-sm text-textColor/50 mb-3 italic">{venue}</p>
            <div class="flex flex-wrap gap-2">
                {links.pdf && (
                    <a href={links.pdf} target="_blank" rel="noopener noreferrer"
                       class="publication-btn publication-btn-pdf">
                        PDF
                    </a>
                )}
                {links.project && (
                    <a href={links.project} target="_blank" rel="noopener noreferrer"
                       class="publication-btn publication-btn-project">
                        Project
                    </a>
                )}
                {links.code && (
                    <a href={links.code} target="_blank" rel="noopener noreferrer"
                       class="publication-btn publication-btn-code">
                        Code
                    </a>
                )}
            </div>
        </div>
    </div>
</article>
