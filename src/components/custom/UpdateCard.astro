---
import type { Post } from "@/lib/interfaces";
import { getNavLink } from "@/lib/blog-helpers";

interface Props {
    post: Post;
}

const { post } = Astro.props;

// Excerpt 파싱: 논문명, 학회명, publication 링크
function parseExcerpt(excerpt: string) {
    const lines = excerpt.split('\n');
    const paperTitle = lines[0] || '';
    const venue = lines[1] || '';
    let publicationLink = '';

    const separatorIndex = lines.findIndex(line => line.trim() === '---');
    if (separatorIndex !== -1) {
        lines.slice(separatorIndex + 1).forEach(line => {
            const match = line.match(/^publication:\s*(.+)$/i);
            if (match && match[1]) {
                publicationLink = match[1].trim();
            }
        });
    }

    return { paperTitle, venue, publicationLink };
}

const { paperTitle, venue, publicationLink } = parseExcerpt(post.Excerpt || '');
const formattedDate = post.Date ? new Date(post.Date).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short'
}) : '';
---

<article class="update-item">
    <div class="update-timeline">
        <span class="update-date">{formattedDate}</span>
        <span class="update-dot"></span>
    </div>
    <div class="update-content">
        <p>
            🎉 <strong>{paperTitle}</strong>이(가) <em>{venue}</em>에 accept 되었습니다!
        </p>
        {publicationLink && (
            <a href={getNavLink(publicationLink)} class="update-link">
                자세히 보기 →
            </a>
        )}
    </div>
</article>
