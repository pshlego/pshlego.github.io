---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags, tagColorClass, tagPath } from "@/lib/content";

const tags = await getAllTags();
---

<BaseLayout title="All Tags">
	<h1 class="title mb-6">Tags</h1>
	<ul class="flex flex-wrap gap-2 lg:w-4/5">
		{
			tags.map(({ name, count }) => (
				<li>
					<a
						href={tagPath(name)}
						class:list={["tag-chip gap-1.5 px-2 text-base", tagColorClass(name)]}
					>
						{name}
						<span class="text-xs opacity-60">{count}</span>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
