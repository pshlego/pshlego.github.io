---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsItem from "@/components/NewsItem.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { getNews, getSelectedPublications } from "@/lib/content";
import { site } from "@/site.config";

const home = (await getEntry("pages", "home"))!;
const { Content } = await render(home);
const news = await getNews();
const recentNews = news.slice(0, site.newsCount);
const pastNews = news.slice(site.newsCount);
const selected = await getSelectedPublications();
---

<BaseLayout description={home.data.description}>
	<div class="wide-column" data-pagefind-body>
		<section class="mt-10 flex flex-col-reverse gap-6 md:flex-row md:items-start">
			<div class="flex-1">
				<h2 id="about" class="mb-2 text-2xl font-semibold">{home.data.title}</h2>
				<div class="prose"><Content /></div>
			</div>
			{
				home.data.photo && (
					<Image
						src={home.data.photo}
						alt={`Photo of ${home.data.title}`}
						widths={[240, 480]}
						sizes="240px"
						loading="eager"
						class="w-48 self-center rounded-md md:w-[30%] md:self-start"
					/>
				)
			}
		</section>

		{
			recentNews.length > 0 && (
				<section class="mt-20">
					<h2 id="news" class="section-title">
						News
					</h2>
					{recentNews.map((item) => (
						<NewsItem item={item} />
					))}
					{pastNews.length > 0 && (
						<details class="mt-3">
							<summary class="cursor-pointer font-semibold">Past notices</summary>
							<div class="mt-3">
								{pastNews.map((item) => (
									<NewsItem item={item} />
								))}
							</div>
						</details>
					)}
				</section>
			)
		}

		{
			selected.length > 0 && (
				<section class="mt-16 mb-12">
					<h2 id="publications" class="section-title">
						Selected Publications
					</h2>
					<div class="space-y-6">
						{selected.map((pub) => (
							<PublicationCard pub={pub} />
						))}
					</div>
					<p class="mt-8 text-center">
						<a href="/collections/publications/" class="text-link hover:underline">
							View all publications →
						</a>
					</p>
				</section>
			)
		}
	</div>
</BaseLayout>
